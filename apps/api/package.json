{
	"name": "@txn-recon/api",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "npm run prisma:generate",
		"dev": "tsx watch src/server.ts",
		"build": "npm run prisma:generate && tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"pretest": "npm run prisma:generate",
		"test": "vitest run",
		"typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
		"prisma:generate": "prisma generate",
		"prisma:validate": "prisma validate",
		"db:init": "tsx prisma/db-init.ts",
		"predb:seed": "npm run prisma:generate",
		"db:seed": "tsx prisma/seed.ts",
		"db:reset": "tsx prisma/db-reset.ts"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"better-sqlite3": "^12.11.1",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.9",
		"express": "^5.3.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"prisma": "^7.10.1",
		"tsx": "^4.23.15"
	}
}
