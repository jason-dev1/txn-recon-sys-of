{
	"name": "txn-recon-sys-of",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.0.0",
		"npm": ">=10.0.0"
	},
	"workspaces": [
		"apps/api",
		"apps/web"
	],
	"scripts": {
		"dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
		"dev:api": "npm --workspace @txn-recon/api run dev",
		"dev:web": "npm --workspace @txn-recon/web run dev",
		"build": "npm run build --workspaces --if-present",
		"lint": "eslint .",
		"test": "npm test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^10.0.6",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	}
}
